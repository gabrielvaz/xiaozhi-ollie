      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pergunte ao Claude…"
          }
        }
      }
    },
    "Browsing": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesquisando"
