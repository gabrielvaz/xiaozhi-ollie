{
  "sourceLanguage": "en",
  "strings": {
    "5-hour window resets": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A janela de 5 horas reinicia"
          }
        }
      }
    },
    "After you talk to a session, the watch reads Claude's answer when the turn ends.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois que você fala com uma sessão, o relógio lê a resposta do Claude quando ela termina."
          }
        }
      }
    },
    "Allow": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir"
          }
        }
      }
    },
