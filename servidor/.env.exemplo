# Copie para .env e preencha. O .env fica só no Mac (chmod 600).

# Idioma do Ollie: pt-BR, en-US, zh-CN ou es-ES (o firmware usa o mesmo: compilar.sh lê daqui)
IDIOMA=pt-BR

# Provedor compatível com a API da OpenAI.
#   OpenRouter: https://openrouter.ai/api/v1   (chave em https://openrouter.ai/keys)
#   OpenAI:     https://api.openai.com/v1
API_BASE_URL=https://openrouter.ai/api/v1
API_KEY=

# Modelos (confira com ./testar-api.sh, que faz uma chamada real de cada um)
MODELO_LLM=openai/gpt-6-luna
MODELO_ASR=openai/gpt-4o-mini-transcribe
MODELO_TTS=microsoft/mai-voice-2.1-flash
VOZ=                 # vazio = voz padrão do idioma (pt-BR-FranciscaNeural, en-US-JennyNeural, zh-CN-XiaoxiaoNeural, es-ES-ElviraNeural)
TTS_FORMATO=mp3

# Reuniões: transcrição mais precisa e resumo com modelo mais forte
MODELO_ASR_REUNIAO=openai/gpt-4o-transcribe
MODELO_RESUMO=openai/gpt-6.1-sol

# Nome público do Mac pelo Tailscale Funnel (sem https://)
HOST_PUBLICO=seu-mac.seu-tailnet.ts.net

# Gerados automaticamente (não compartilhe): caminho secreto do Funnel e chave de assinatura dos tokens
SEGREDO=
AUTH_KEY=

# Pastas onde a ponte procura projetos (separadas por ":")
PONTE_RAIZES=$HOME/dev

# Seu nome (saudações na tela e no prompt) e palavras que a transcrição de reuniões deve reconhecer
NOME_USUARIO=
WATCHER_VOCABULARIO="Claude Code, Codex, herdr, Multica"

# Discos mostrados em mac_status (separados por ":")
WATCHER_DISCOS=/
